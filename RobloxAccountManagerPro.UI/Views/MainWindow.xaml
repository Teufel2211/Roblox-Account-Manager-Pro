<Window x:Class="RobloxAccountManagerPro.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roblox Account Manager Pro - Manage. Launch. Secure."
        Height="800"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#FFFFFF">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="#1A1F3A" Margin="0" Padding="20" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="ROBLOX AMP" FontSize="20" FontWeight="Bold" Foreground="#06B6D4" Margin="0,0,0,30" />
                <Button Content="📊 Dashboard" Height="40" Margin="0,10,0,0" Background="#06B6D4" Foreground="#0F172A" FontWeight="Bold" Command="{Binding ShowDashboardCommand}" />
                <Button Content="👥 Accounts" Height="40" Margin="0,10,0,0" Background="#1E293B" Foreground="#FFFFFF" Command="{Binding ShowAccountsCommand}" />
                <Button Content="⚙️ Settings" Height="40" Margin="0,10,0,0" Background="#1E293B" Foreground="#FFFFFF" Command="{Binding ShowSettingsCommand}" />
                <Button Content="📝 Logs" Height="40" Margin="0,10,0,0" Background="#1E293B" Foreground="#FFFFFF" Command="{Binding ShowLogsCommand}" />
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <TabControl Grid.Column="1" Background="#0F172A" Foreground="#FFFFFF" SelectedIndex="{Binding SelectedTabIndex}">
            <!-- Dashboard Tab -->
            <TabItem Header="Dashboard" Background="#1A1F3A">
                <Grid Background="#0F172A">
                    <StackPanel Orientation="Vertical" Margin="20">
                        <!-- Statistics Cards -->
                        <Grid Height="120" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#06B6D4" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0" Padding="20">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Total Accounts" Foreground="#94A3B8" FontSize="12" />
                                    <TextBlock Text="{Binding DashboardViewModel.TotalAccounts}" Foreground="#06B6D4" FontSize="32" FontWeight="Bold" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#06B6D4" BorderThickness="1" CornerRadius="8" Margin="10,0,10,0" Padding="20">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Favorites" Foreground="#94A3B8" FontSize="12" />
                                    <TextBlock Text="{Binding DashboardViewModel.FavoriteAccounts}" Foreground="#06B6D4" FontSize="32" FontWeight="Bold" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#1E293B" BorderBrush="#06B6D4" BorderThickness="1" CornerRadius="8" Margin="10,0,10,0" Padding="20">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Active Instances" Foreground="#94A3B8" FontSize="12" />
                                    <TextBlock Text="{Binding DashboardViewModel.ActiveInstances}" Foreground="#06B6D4" FontSize="32" FontWeight="Bold" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="#1E293B" BorderBrush="#06B6D4" BorderThickness="1" CornerRadius="8" Margin="10,0,0,0" Padding="20">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Memory Usage" Foreground="#94A3B8" FontSize="12" />
                                    <TextBlock Text="{Binding DashboardViewModel.TotalMemoryUsageMb, StringFormat={}{0} MB}" Foreground="#06B6D4" FontSize="32" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Quick Actions -->
                        <Grid Height="50" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0" Content="▶ Start All" Padding="15,12" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,10,0" Command="{Binding DashboardViewModel.StartAllCommand}" />
                            <Button Grid.Column="1" Content="⭐ Start Favorites" Padding="15,12" Background="#06B6D4" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,10,0" Command="{Binding DashboardViewModel.StartFavoritesCommand}" />
                            <Button Grid.Column="2" Content="⏹ Stop All" Padding="15,12" Background="#EF4444" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,10,0" Command="{Binding DashboardViewModel.StopAllCommand}" />
                            <Button Grid.Column="3" Content="🔄 Refresh" Padding="15,12" Background="#6366F1" Foreground="#FFFFFF" FontWeight="Bold" Command="{Binding DashboardViewModel.RefreshCommand}" />
                        </Grid>

                        <!-- Recent Accounts -->
                        <TextBlock Text="Recent Accounts" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10" />
                        <ListBox Height="300" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#06B6D4" BorderThickness="1" ItemsSource="{Binding DashboardViewModel.RecentAccounts}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Username}" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock Text=" - " Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding Category}" Foreground="#94A3B8" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Accounts Tab -->
            <TabItem Header="Accounts" Background="#1A1F3A">
                <Grid Background="#0F172A" Margin="20">
                    <StackPanel VerticalAlignment="Top">
                        <!-- Search -->
                        <Grid Height="40" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Background="#1E293B" Foreground="#FFFFFF" Padding="10" Text="{Binding AccountManagerViewModel.SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="🔎 Search" Padding="20,0" Background="#6366F1" Foreground="#FFFFFF" FontWeight="Bold" Margin="10,0,0,0" Command="{Binding AccountManagerViewModel.SearchCommand}" />
                        </Grid>

                        <!-- Add new account -->
                        <Border Background="#1E293B" BorderBrush="#06B6D4" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Add New Account" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Background="#0F172A" Foreground="#FFFFFF" Padding="10" Text="{Binding AccountManagerViewModel.NewAccountUsername, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Display Name:" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Background="#0F172A" Foreground="#FFFFFF" Padding="10" Text="{Binding AccountManagerViewModel.NewAccountDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Password:" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Background="#0F172A" Foreground="#FFFFFF" Padding="10" Text="{Binding AccountManagerViewModel.NewAccountPassword, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Category:" Foreground="#94A3B8" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="3" Grid.Column="1" Background="#0F172A" Foreground="#FFFFFF" ItemsSource="{Binding AccountManagerViewModel.Categories}" SelectedItem="{Binding AccountManagerViewModel.NewAccountCategory, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Notes:" Foreground="#94A3B8" VerticalAlignment="Top" />
                                <TextBox Grid.Row="4" Grid.Column="1" Background="#0F172A" Foreground="#FFFFFF" Padding="10" AcceptsReturn="True" Height="80" Text="{Binding AccountManagerViewModel.NewAccountNotes, UpdateSourceTrigger=PropertyChanged}" />

                                    <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding AccountManagerViewModel.NewAccountIsFavorite}" Foreground="#FFFFFF" Margin="0,0,10,0">Favorite</CheckBox>
                                        <Button Content="🔐 Login and Add" Padding="12,8" Background="#06B6D4" Foreground="#0F172A" FontWeight="Bold" Command="{Binding AccountManagerViewModel.AddAccountCommand}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Refresh" Padding="15,12" Background="#6366F1" Foreground="#FFFFFF" FontWeight="Bold" Command="{Binding AccountManagerViewModel.RefreshCommand}" Margin="0,0,10,0" />
                            <Button Grid.Column="1" Content="Edit" Padding="15,12" Background="#F59E0B" Foreground="#FFFFFF" FontWeight="Bold" Command="{Binding AccountManagerViewModel.EditAccountCommand}" Margin="0,0,10,0" />
                            <Button Grid.Column="2" Content="Delete" Padding="15,12" Background="#EF4444" Foreground="#FFFFFF" FontWeight="Bold" Command="{Binding AccountManagerViewModel.DeleteAccountCommand}" Margin="0,0,10,0" />
                            <Button Grid.Column="3" Content="★ Favorite" Padding="15,12" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" Command="{Binding AccountManagerViewModel.ToggleFavoriteCommand}" />
                        </Grid>

                        <ListBox Height="500" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#06B6D4" BorderThickness="1" ItemsSource="{Binding AccountManagerViewModel.Accounts}" SelectedItem="{Binding AccountManagerViewModel.SelectedAccount, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="{Binding Username}" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock Text=" | " Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding Category}" Foreground="#94A3B8" />
                                        <TextBlock Text=" | " Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding Email}" Foreground="#94A3B8" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Settings" Background="#1A1F3A">
                <Grid Background="#0F172A" Margin="20">
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,20" />
                        <TextBlock Text="Theme:" Foreground="#94A3B8" />
                        <ComboBox Width="200" Background="#1E293B" Foreground="#FFFFFF" SelectedItem="{Binding CurrentTheme}">
                            <ComboBoxItem Content="Dark" />
                            <ComboBoxItem Content="Light" />
                        </ComboBox>
                        <TextBlock Text="\nSettings are not fully implemented yet." Foreground="#94A3B8" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Logs" Background="#1A1F3A">
                <Grid Background="#0F172A" Margin="20">
                    <StackPanel>
                        <TextBlock Text="Logs" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,20" />
                        <TextBlock Text="This page will show application logs and recent actions." Foreground="#94A3B8" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
