<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Colors -->
    <Color x:Key="PrimaryDark">#0F172A</Color>
    <Color x:Key="SecondaryDark">#1A1F3A</Color>
    <Color x:Key="TertiaryDark">#1E293B</Color>
    <Color x:Key="AccentCyan">#06B6D4</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#94A3B8</Color>
    <Color x:Key="SuccessGreen">#10B981</Color>
    <Color x:Key="ErrorRed">#EF4444</Color>
    <Color x:Key="WarningYellow">#F59E0B</Color>

    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#06B6D4" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#94A3B8" />

</ResourceDictionary>
